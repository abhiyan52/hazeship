#!/usr/bin/env python3
"""worklog — the project's system of record for work items.

Every piece of work (feature, bugfix, triage, PR-comment round, ad-hoc task)
gets exactly one item here: who initiated it, from which source, its status,
its links (PR / ClickUp / docs), and a running log. `new` refuses to create
an item that looks like work already recorded, so two agents (or an agent
and a human) don't do the same job twice.

Store: <workspace root>/worklog/ — items/WL-NNNN-<slug>.md + generated
INDEX.md. Workspace root: nearest ancestor with worklog/, else .hazeship/,
else the git toplevel, else cwd.

Commands:
  worklog new TITLE --source clickup|telegram|direct [--actor A] [--ref URL]
              [--summary TEXT] [--status S] [--force]
  worklog find QUERY...             search titles/summaries/refs (ranked)
  worklog list [--status S]
  worklog show ID
  worklog status ID {in-progress,blocked,done,abandoned}
  worklog link ID [--pr URL] [--clickup URL] [--doc URL]   (repeatable)
  worklog note ID TEXT

Exit codes: 0 ok; 2 usage; 3 not found; 4 duplicate suspected (new).
"""

import argparse
import datetime
import os
import re
import subprocess
import sys
from pathlib import Path

STATUSES = ("proposed", "in-progress", "blocked", "done", "abandoned")
SOURCES = ("clickup", "telegram", "direct")
STOPWORDS = {
    "a", "an", "the", "for", "of", "to", "in", "on", "and", "or", "with",
    "fix", "add", "update", "issue", "bug", "task", "work",
}


def now():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def find_root(start):
    p = Path(start).resolve()
    for d in [p, *p.parents]:
        if (d / "worklog").is_dir():
            return d
    for d in [p, *p.parents]:
        if (d / ".hazeship").is_dir():
            return d
    try:
        top = subprocess.run(
            ["git", "-C", str(p), "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
        return Path(top)
    except subprocess.CalledProcessError:
        return p


def store(root):
    return root / "worklog"


def items_dir(root):
    return store(root) / "items"


def parse_item(path):
    text = path.read_text(encoding="utf-8")
    m = re.match(r"\A---\n(.*?)\n---\n?(.*)\Z", text, re.DOTALL)
    if not m:
        raise ValueError(f"{path}: missing frontmatter")
    meta, body = {}, m.group(2)
    key = None
    for line in m.group(1).splitlines():
        if re.match(r"^\S.*:", line):
            key, _, value = line.partition(":")
            key, value = key.strip(), value.strip()
            if key in ("pr", "clickup", "docs"):
                meta[key] = []
            else:
                meta[key] = value
        elif line.strip().startswith("- ") and isinstance(meta.get(key), list):
            meta[key].append(line.strip()[2:].strip())
    meta["_path"] = path
    meta["_body"] = body
    return meta


def dump_item(meta, body):
    lines = ["---"]
    for key in ("id", "title", "status", "actor", "source", "source_ref",
                "created", "updated"):
        lines.append(f"{key}: {meta.get(key, '')}")
    for key in ("pr", "clickup", "docs"):
        lines.append(f"{key}:")
        for url in meta.get(key) or []:
            lines.append(f"  - {url}")
    lines.append("---")
    return "\n".join(lines) + "\n" + body


def all_items(root):
    d = items_dir(root)
    if not d.is_dir():
        return []
    return sorted(
        (parse_item(p) for p in d.glob("WL-*.md")),
        key=lambda i: i.get("id", ""),
    )


def tokens(text):
    return {
        t for t in re.findall(r"[a-z0-9]+", (text or "").lower())
        if t not in STOPWORDS and len(t) > 1
    }


def similarity(a, b):
    ta, tb = tokens(a), tokens(b)
    if not ta or not tb:
        return 0.0
    return len(ta & tb) / min(len(ta), len(tb))


def write_index(root):
    rows = []
    for it in all_items(root):
        links = ", ".join((it.get("pr") or []) + (it.get("clickup") or []))
        rows.append(
            f"| {it['id']} | {it['title']} | {it['status']} | "
            f"{it.get('actor', '')} | {it.get('source', '')} | "
            f"{it.get('updated', '')} | {links} |"
        )
    content = (
        "# Work Ledger\n\n"
        "Generated by `tools/worklog` — do not edit by hand. "
        "One row per work item; details in `items/`.\n\n"
        "| ID | Title | Status | Actor | Source | Updated | Links |\n"
        "|---|---|---|---|---|---|---|\n" + "\n".join(rows) + "\n"
    )
    (store(root) / "INDEX.md").write_text(content, encoding="utf-8")


def save(root, meta):
    meta["updated"] = now()
    meta["_path"].write_text(
        dump_item(meta, meta["_body"]), encoding="utf-8"
    )
    write_index(root)


def get_item(root, item_id):
    for it in all_items(root):
        if it["id"] == item_id:
            return it
    print(f"worklog: no item {item_id}", file=sys.stderr)
    sys.exit(3)


def log_line(actor, text):
    stamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    return f"- {stamp} [{actor}] {text}"


def cmd_new(root, args):
    dup_exact, dup_similar = [], []
    for it in all_items(root):
        if args.ref and args.ref == it.get("source_ref"):
            dup_exact.append(it)
        elif similarity(args.title, it["title"]) >= 0.6:
            dup_similar.append(it)
    blocking = dup_exact + [
        i for i in dup_similar if i["status"] != "abandoned"
    ]
    if blocking and not args.force:
        print("worklog: possible duplicate of existing work:", file=sys.stderr)
        for it in blocking:
            print(
                f"  {it['id']}  [{it['status']}]  {it['title']}  "
                f"(actor: {it.get('actor', '?')})",
                file=sys.stderr,
            )
        print(
            "Check these before redoing work. Use --force to create anyway.",
            file=sys.stderr,
        )
        sys.exit(4)

    items_dir(root).mkdir(parents=True, exist_ok=True)
    existing = [int(i["id"].split("-")[1]) for i in all_items(root)]
    item_id = f"WL-{(max(existing) + 1 if existing else 1):04d}"
    slug = re.sub(r"[^a-z0-9]+", "-", args.title.lower()).strip("-")[:48]
    path = items_dir(root) / f"{item_id}-{slug}.md"
    meta = {
        "id": item_id,
        "title": args.title,
        "status": args.status,
        "actor": args.actor,
        "source": args.source,
        "source_ref": args.ref or "",
        "created": now(),
        "pr": [],
        "clickup": [],
        "docs": [],
        "_path": path,
        "_body": (
            f"\n## Summary\n\n{args.summary or '(pending)'}\n\n## Log\n\n"
            + log_line(args.actor, f"created (source: {args.source})")
            + "\n"
        ),
    }
    save(root, meta)
    print(item_id)


def cmd_find(root, args):
    query = " ".join(args.query)
    scored = []
    for it in all_items(root):
        hay = " ".join([
            it["title"], it.get("source_ref", ""), it["_body"],
            *(it.get("pr") or []), *(it.get("clickup") or []),
        ])
        score = max(similarity(query, it["title"]), similarity(query, hay))
        if query.lower() in hay.lower():
            score = max(score, 0.9)
        if score >= 0.3:
            scored.append((score, it))
    if not scored:
        print("no matches")
        return
    for score, it in sorted(scored, key=lambda s: -s[0]):
        print(
            f"{it['id']}  [{it['status']}]  {it['title']}  "
            f"(actor: {it.get('actor', '?')}, source: {it.get('source', '?')},"
            f" score: {score:.2f})"
        )


def cmd_list(root, args):
    for it in all_items(root):
        if args.status and it["status"] != args.status:
            continue
        print(f"{it['id']}  [{it['status']}]  {it['title']}")


def cmd_show(root, args):
    it = get_item(root, args.id)
    print(dump_item(it, it["_body"]), end="")


def cmd_status(root, args):
    it = get_item(root, args.id)
    old = it["status"]
    it["status"] = args.state
    it["_body"] += log_line(args.actor, f"status: {old} -> {args.state}") + "\n"
    save(root, it)
    print(f"{it['id']}: {old} -> {args.state}")


def cmd_link(root, args):
    it = get_item(root, args.id)
    for field, urls in (("pr", args.pr), ("clickup", args.clickup),
                        ("docs", args.doc)):
        for url in urls or []:
            existing = it.get(field) or []
            if url not in existing:
                it[field] = existing + [url]
                it["_body"] += log_line(args.actor, f"link {field}: {url}") + "\n"
    save(root, it)
    print(f"{it['id']}: links updated")


def cmd_note(root, args):
    it = get_item(root, args.id)
    it["_body"] += log_line(args.actor, args.text) + "\n"
    save(root, it)
    print(f"{it['id']}: noted")


def main():
    parser = argparse.ArgumentParser(prog="worklog", description=__doc__)
    parser.add_argument("--root", help="workspace root (default: walk up)")
    parser.add_argument("--actor", default=os.environ.get("WORKLOG_ACTOR", "unknown"),
                        help="who is doing/recording this (agent or human)")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("new")
    p.add_argument("title")
    p.add_argument("--source", required=True, choices=SOURCES)
    p.add_argument("--ref", help="source link/id (ClickUp URL, chat link...)")
    p.add_argument("--summary")
    p.add_argument("--status", default="in-progress", choices=STATUSES)
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_new)

    p = sub.add_parser("find")
    p.add_argument("query", nargs="+")
    p.set_defaults(func=cmd_find)

    p = sub.add_parser("list")
    p.add_argument("--status", choices=STATUSES)
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("show")
    p.add_argument("id")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("status")
    p.add_argument("id")
    p.add_argument("state", choices=STATUSES[1:])
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("link")
    p.add_argument("id")
    p.add_argument("--pr", action="append")
    p.add_argument("--clickup", action="append")
    p.add_argument("--doc", action="append")
    p.set_defaults(func=cmd_link)

    p = sub.add_parser("note")
    p.add_argument("id")
    p.add_argument("text")
    p.set_defaults(func=cmd_note)

    args = parser.parse_args()
    root = Path(args.root).resolve() if args.root else find_root(Path.cwd())
    args.func(root, args)


if __name__ == "__main__":
    main()
